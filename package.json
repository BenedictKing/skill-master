{
  "name": "skill-master",
  "version": "0.1.11",
  "description": "Cross-platform skill package manager for AI coding agents",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "skill-master": "./bin/skill-master.mjs"
  },
  "files": [
    "dist",
    "bin",
    "docs",
    "schemas",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "cli": "tsx src/cli.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "skill",
    "manager",
    "claude-code",
    "opencode",
    "cursor",
    "cline",
    "agent",
    "ai",
    "skills"
  ],
  "author": "BenedictKing",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BenedictKing/skill-master.git"
  },
  "bugs": {
    "url": "https://github.com/BenedictKing/skill-master/issues"
  },
  "homepage": "https://github.com/BenedictKing/skill-master#readme",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.18.0",
    "tsx": "^4.20.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
